# PostgreSQL (Supabase) connection strings — used by root-level Prisma tooling
DATABASE_TRANSACTION_POOLER_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/postgres
DATABASE_SESSION_POOLER_URL=postgresql://user:password@host:5432/postgres

# Local container host port overrides (for docker-compose.yml)
# Change these if 5432 or 6379 are already used on your machine.
PGHOST_PORT=5432
REDIS_HOST_PORT=6379
