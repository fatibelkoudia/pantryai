    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "fastify": "5.8.4",
    "prisma": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
