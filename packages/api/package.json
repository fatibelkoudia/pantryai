    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "fastify": "5.12.1",
    "prisma": "^7.9.1",
