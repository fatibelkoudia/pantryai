{
  "name": "@pantryai/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:worker": "node dist/worker",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "prisma db seed",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:db:setup": "DATABASE_DIRECT_URL=postgresql://pantryai:pantryai@localhost:5433/pantryai_test prisma migrate deploy",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "generate-lessons": "tsx scripts/generate-lessons.ts",
    "test:parsers": "tsx scripts/test-parsers.ts",
    "record-ocr": "tsx scripts/record-ocr-fixture.ts",
    "smoke-fixtures": "tsx scripts/smoke-fixtures.ts",
    "generate-expected": "tsx scripts/generate-expected.ts",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
