# PostgreSQL (Supabase) — transaction pooler for the app
DATABASE_TRANSACTION_POOLER_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct connection for migrations (bypasses PgBouncer transaction mode)
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/postgres

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudflare R2 (receipt image storage — ephemeral, deleted within 24h)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pantryai-receipts

# Mistral AI (OCR primary — EU data sovereignty)
MISTRAL_API_KEY=

# API server
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
