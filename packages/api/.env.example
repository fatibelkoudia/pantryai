# PostgreSQL (Supabase) — transaction pooler for the app
DATABASE_TRANSACTION_POOLER_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct connection for migrations (bypasses PgBouncer transaction mode)
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/postgres
DATABASE_TEST_URL=postgresql://pantryai:pantryai@localhost:5433/pantryai_test

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudflare R2 (receipt image storage — ephemeral, deleted within 24h)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pantryai

# Mistral AI (OCR primary, and the offline `pnpm generate-lessons` script — EU data sovereignty)
MISTRAL_API_KEY=

# API server
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Background jobs: leave unset for a single process (it then runs the OCR queue
# and the cron jobs itself). In the split prod setup, the API container sets this
# to false and the dedicated worker container sets it to true. Compose handles
# this, so it normally does not belong in this file.
# RUN_OCR_WORKER=

# Sentry error monitoring. Leave empty to disable (no errors are sent).
SENTRY_DSN=

# BullMQ dashboard at /admin/queues. Set both to enable it (behind basic auth);
# leave either empty to not mount it at all.
BULLBOARD_USER=
BULLBOARD_PASSWORD=
