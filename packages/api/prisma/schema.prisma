generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  stockItems   StockItem[]
  ocrJobs      OcrJob[]
  devices      UserDevice[]
  shoppingItems ShoppingItem[]

  @@index([email])
  @@map("users")
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_devices")
}

model Product {
  id            String      @id @default(uuid())
  name          String
  brand         String?
  ean13         String?     @unique
  category      String?
  imageUrl      String?
  nutritionData Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stockItems    StockItem[]

  @@index([ean13])
  @@index([category])
  @@map("products")
}

enum StockLocation {
  FRIDGE
  FREEZER
  PANTRY
}

model StockItem {
  id             String        @id @default(uuid())
  userId         String
  productId      String
  quantity       Float
  unit           String
  expirationDate DateTime?
  expirationNotifiedAt DateTime?
  location       StockLocation @default(PANTRY)
  addedAt        DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  user           User          @relation(fields: [userId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([expirationDate])
  @@map("stock_items")
}

model OcrJob {
  id          String    @id @default(uuid())
  userId      String
  status      OcrStatus @default(PENDING)
  imageKey    String?
  retailer    String?
  rawText     String?
  parsedItems Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("ocr_jobs")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  CONFIRMED
  FAILED
}

enum RecipeSource {
  LOCAL
  THEMEALDB
}

model Recipe {
  id           String             @id @default(uuid())
  externalId   String?            @unique // TheMealDB idMeal
  name         String
  category     String?
  instructions String?
  imageUrl     String?
  source       RecipeSource       @default(LOCAL)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]

  @@index([source])
  @@map("recipes")
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  measure  String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

enum ShoppingItemSource {
  LOW_STOCK
  RECIPE
  MANUAL
}

model ShoppingItem {
  id        String             @id @default(uuid())
  userId    String
  name      String
  quantity  Float?
  unit      String?
  checked   Boolean            @default(false)
  source    ShoppingItemSource @default(MANUAL)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("shopping_items")
}
