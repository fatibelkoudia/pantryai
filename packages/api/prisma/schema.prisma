generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  // id of one of the built-in avatars (see shared/theme/avatars.ts), not an image
  avatarId     String?
  // set when the user finishes (or skips) the first-run onboarding. Accounts that
  // existed before onboarding shipped were backfilled at migration time, so only
  // brand new signups ever see the flow.
  onboardingCompletedAt DateTime?
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  stockItems   StockItem[]
  ocrJobs      OcrJob[]
  devices      UserDevice[]
  shoppingItems ShoppingItem[]
  xp           UserXp?
  challenges   UserChallenge[]
  lessons      LessonCompletion[]
  settings     UserSettings?

  @@index([email])
  @@map("users")
}

// The knobs the user can change from the profile page. One row per user, and we
// only create it the first time settings are read, so existing accounts simply
// fall back to the defaults below.
model UserSettings {
  userId                String        @id
  locale                String        @default("en")
  // a recipe must use at least this many items from the stock to be suggested
  recipeMinMatchedItems Int           @default(1)
  // and the user must own at least this fraction of its ingredients (the 70% rule)
  recipeMatchThreshold  Float         @default(0.7)
  // days before the expiration date where an item starts counting as "expiring soon"
  expiringSoonDays      Int           @default(3)
  // quantity at or below this counts as low stock for the shopping list
  lowStockThreshold     Int           @default(1)
  defaultStockLocation  StockLocation @default(PANTRY)
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_devices")
}

model Product {
  id            String      @id @default(uuid())
  name          String
  brand         String?
  ean13         String?     @unique
  category      String?
  imageUrl      String?
  nutritionData Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stockItems    StockItem[]

  @@index([ean13])
  @@index([category])
  @@map("products")
}

enum StockLocation {
  FRIDGE
  FREEZER
  PANTRY
}

// How a stock item left the pantry. Set when an item is removed (soft-deleted);
// null while the item is still in stock. Feeds the Waste Level score: CONSUMED is
// the "good" outcome, DISCARDED and EXPIRED both count as waste.
enum StockDisposition {
  CONSUMED
  DISCARDED
  EXPIRED
}

model StockItem {
  id             String        @id @default(uuid())
  userId         String
  productId      String
  quantity       Float
  unit           String
  expirationDate DateTime?
  expirationNotifiedAt DateTime?
  location       StockLocation @default(PANTRY)
  disposition    StockDisposition?
  addedAt        DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  user           User          @relation(fields: [userId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([expirationDate])
  @@index([userId, deletedAt])
  @@map("stock_items")
}

model OcrJob {
  id          String    @id @default(uuid())
  userId      String
  status      OcrStatus @default(PENDING)
  imageKey    String?
  retailer    String?
  rawText     String?
  parsedItems Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("ocr_jobs")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  CONFIRMED
  FAILED
}

enum RecipeSource {
  LOCAL
  THEMEALDB
}

model Recipe {
  id           String             @id @default(uuid())
  externalId   String?            @unique // TheMealDB idMeal
  name         String
  category     String?
  instructions String?
  imageUrl     String?
  source       RecipeSource       @default(LOCAL)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]

  @@index([source])
  @@map("recipes")
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  measure  String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

enum ShoppingItemSource {
  LOW_STOCK
  RECIPE
  MANUAL
}

model ShoppingItem {
  id        String             @id @default(uuid())
  userId    String
  name      String
  quantity  Float?
  unit      String?
  checked   Boolean            @default(false)
  // when the item was last ticked off, so weekly challenges can count only this week
  checkedAt DateTime?
  source    ShoppingItemSource @default(MANUAL)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("shopping_items")
}

// One row per user that just keeps their XP total. The gamification module adds
// to `total` whenever the user finishes a challenge.
model UserXp {
  userId    String   @id
  total     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_xp")
}

// One Trashy challenge (Clean Out Your Fridge, No Waste Weekend, and so on). These
// are added on startup. `rule` is some JSON that says how we count progress for it
// (see gamification/challenges.ts and challenge-rules.ts).
model Challenge {
  id          String          @id @default(uuid())
  key         String          @unique
  title       String
  description String
  xp          Int
  rule        Json
  createdAt   DateTime        @default(now())
  users       UserChallenge[]

  @@map("challenges")
}

// How far one user has got on one challenge, for one week. Challenges reset every
// week, so there is one row per user + challenge + week (`weekKey` looks like
// "2026-W28"). `completedAt` starts null and we set it once when they finish that
// week's run. We use that to make sure we only ever give the XP once per week.
// Rows with an empty weekKey are from before challenges became weekly.
model UserChallenge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  weekKey     String    @default("")
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, weekKey])
  @@index([userId])
  @@map("user_challenges")
}

// One row per lesson a user finished. The primary key is what guarantees the XP
// for a lesson is only paid once, and the completedAt dates feed the daily streak.
model LessonCompletion {
  userId      String
  tipId       String
  correct     Boolean?
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@id([userId, tipId])
  @@index([userId, completedAt])
  @@map("lesson_completions")
}
