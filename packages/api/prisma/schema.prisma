generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  stockItems StockItem[]
  ocrJobs    OcrJob[]

  @@map("users")
}

model Product {
  id         String      @id @default(uuid())
  name       String
  barcode    String?     @unique
  category   String?
  imageUrl   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  stockItems StockItem[]

  @@index([barcode])
  @@index([category])
  @@map("products")
}

model StockItem {
  id        String    @id @default(uuid())
  userId    String
  productId String
  quantity  Float
  unit      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("stock_items")
}

model OcrJob {
  id         String    @id @default(uuid())
  userId     String
  status     OcrStatus @default(PENDING)
  receiptUrl String?
  result     Json?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("ocr_jobs")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
