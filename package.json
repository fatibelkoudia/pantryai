{
  "name": "pantryai",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prisma:generate": "pnpm --filter @pantryai/api prisma:generate",
    "prisma:studio": "pnpm --filter @pantryai/api prisma:studio",
    "prisma:validate": "pnpm --filter @pantryai/api prisma:validate",
    "prisma:format": "pnpm --filter @pantryai/api prisma:format",
    "prisma:db:push": "pnpm --filter @pantryai/api prisma:db:push",
    "prisma:db:pull": "pnpm --filter @pantryai/api prisma:db:pull",
    "prisma:migrate:dev": "pnpm --filter @pantryai/api prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @pantryai/api prisma:migrate:deploy",
    "prisma:migrate:status": "pnpm --filter @pantryai/api prisma:migrate:status",
    "prisma:migrate:reset": "pnpm --filter @pantryai/api prisma:migrate:reset",
    "prisma:seed": "pnpm --filter @pantryai/api prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "podman-compose up -d",
    "docker:down": "podman-compose down",
    "docker:reset": "podman-compose down -v && podman-compose up -d"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "tesseract.js",
      "unrs-resolver"
    ]
  }
}
